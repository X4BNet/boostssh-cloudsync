# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Use a version tag or git-<full-commit-SHA> to pin a deployment.
CLOUDSYNC_TAG=latest
# Set false after creating accounts to disable new registrations.
REGISTRATION_ENABLED=true
# Empty means forwarding headers are ignored. Specify only actual proxy IPs/CIDRs.
TRUSTED_PROXIES=
